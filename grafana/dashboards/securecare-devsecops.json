{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "color": "red", "text": "DOWN" }, "1": { "color": "green", "text": "UP" } }, "type": "value" }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "expr": "up{job=\"securecare-app\"}", "refId": "A" }],
      "title": "SecureCare App Availability",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 70 }, { "color": "red", "value": 85 }] }
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "showThresholdMarkers": true },
      "targets": [{ "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[2m])) * 100)", "refId": "A" }],
      "title": "Host CPU Usage (%)",
      "type": "gauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 75 }, { "color": "red", "value": 88 }] }
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "showThresholdMarkers": true },
      "targets": [{ "expr": "(1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100", "refId": "A" }],
      "title": "Host Memory Usage (%)",
      "type": "gauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 75 }, { "color": "red", "value": 85 }] }
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "showThresholdMarkers": true },
      "targets": [{ "expr": "(1 - (node_filesystem_avail_bytes{mountpoint=\"/\",fstype!=\"tmpfs\"} / node_filesystem_size_bytes{mountpoint=\"/\",fstype!=\"tmpfs\"})) * 100", "refId": "A" }],
      "title": "Root Disk Usage (%)",
      "type": "gauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 4 },
      "id": 5,
      "targets": [{ "expr": "sum by (route, status_code) (rate(securecare_http_requests_total[2m]))", "legendFormat": "{{route}} ({{status_code}})", "refId": "A" }],
      "title": "SecureCare HTTP Request Rate by Route & Status",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 4 },
      "id": 6,
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(securecare_http_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p95 Latency", "refId": "A" },
        { "expr": "histogram_quantile(0.50, sum(rate(securecare_http_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p50 Latency", "refId": "B" }
      ],
      "title": "HTTP Request Latency (p50 & p95)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 11 },
      "id": 7,
      "targets": [
        { "expr": "sum by (outcome) (increase(securecare_auth_login_attempts_total[15m]))", "legendFormat": "Login {{outcome}}", "refId": "A" },
        { "expr": "sum by (status_code) (increase(securecare_unauthorized_access_total[15m]))", "legendFormat": "Unauthorized {{status_code}}", "refId": "B" }
      ],
      "title": "Security Telemetry: Logins & Unauthorized Access (15m)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 11 },
      "id": 8,
      "targets": [{ "expr": "topk(6, label_replace(label_replace(label_replace(container_memory_working_set_bytes{id=~\"/system\\\\.slice/(jenkins|docker|containerd|nginx)\\\\.service|/system\\\\.slice/snap\\\\.amazon-ssm-agent.*|/system\\\\.slice/docker-[^/]+\\\\.scope/(kubepods|system)\\\\.slice\"}, \"unit\", \"$1\", \"id\", \"^/system\\\\.slice/(.+)$\"), \"unit\", \"minikube/$1\", \"unit\", \"^docker-[^/]+\\\\.scope/(.+)$\"), \"unit\", \"ssm-agent.service\", \"unit\", \"^snap\\\\.amazon-ssm-agent.*$\"))", "legendFormat": "{{unit}}", "refId": "A" }],
      "title": "Top Service & Minikube Memory Working Set",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 18 },
      "id": 9,
      "targets": [{ "expr": "securecare_patients_total", "refId": "A" }],
      "title": "Synthetic Patients Loaded",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 18 },
      "id": 10,
      "targets": [{ "expr": "securecare_appointments_total", "refId": "A" }],
      "title": "Synthetic Appointments Loaded",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 18 },
      "id": 11,
      "targets": [{ "expr": "count(up == 1)", "refId": "A" }],
      "title": "Healthy Prometheus Scrape Targets",
      "type": "stat"
    }
  ],
  "refresh": "15s",
  "schemaVersion": 39,
  "tags": ["vle9", "healthcare", "devsecops", "security"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "browser",
  "title": "VLE-9 SecureCare DevSecOps & Security Overview",
  "uid": "vle9-securecare-overview",
  "version": 1
